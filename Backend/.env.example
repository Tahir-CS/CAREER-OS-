# CareerOS backend environment

# Database
DATABASE_URL=postgresql://admin:password123@localhost:5432/careeros?schema=public

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=resumes
AWS_REGION=us-east-1

# Gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
# Stable defaults used by the worker. Override only when intentionally testing another supported model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Live job discovery
# Adzuna gives CareerOS cross-company job search. Register for an app ID/key at developer.adzuna.com.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOB_SEARCH_DEFAULT_COUNTRY=us

# Optional direct ATS sources. Format: Display Company|board-token,Display Company|board-token
# Greenhouse GET job-board endpoints and Lever published-posting endpoints are public.
GREENHOUSE_JOB_BOARDS=
LEVER_JOB_SITES=

# API
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Optional error reporting
SENTRY_DSN=

# Production examples:
# NODE_ENV=production
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# PORT=8080
# DATABASE_URL=postgresql://user:password@database-host:5432/careeros?schema=public
# REDIS_URL=redis://redis-host:6379
# MINIO_ENDPOINT=https://object-storage.example.com
